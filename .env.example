APP_ENV=local

# Core pipeline.
STOP_MARKER="NOI DUNG VU AN"
MAX_PAGES_BEFORE_CONTENT_MARKER=7
OCR_DPI=300
SAVE_DEBUG_VISUAL=false
SAVE_DEBUG_JSON=false
ALLOW_CONTRACT_FIXTURES=false

# OCR backend selection. Main candidate is Surya OCR.
# Surya runtime wiring/benchmark is completed in later phases; this is the target default.
OCR_BACKEND=surya
FALLBACK_OCR_BACKEND=

# Legacy only; not main/default path.
ENABLE_TESSERACT_OCR=false
TESSERACT_CMD=
TESSERACT_LANG=vie+eng

# Google OCR adapters are opt-in.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=

# OpenAI/Gemini OCR adapters are opt-in.
ENABLE_CLOUD_OCR=false
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-4.1-mini
GOOGLE_API_KEY=
GEMINI_OCR_MODEL=gemini-2.5-flash

# Main OCR candidate.
ENABLE_SURYA_OCR=true
SURYA_LANGS=vi

# Extractor backend selection.
EXTRACTOR_BACKEND=local_llm
ENABLE_LOCAL_LLM_EXTRACTION=true
LOCAL_LLM_PROVIDER=vllm
LOCAL_LLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_TEMPERATURE=0
LOCAL_LLM_TIMEOUT_SECONDS=300
LOCAL_LLM_JSON_MODE=true
LOCAL_LLM_CONTEXT_WINDOW=8192
LOCAL_LLM_MAX_OUTPUT_TOKENS=1024
LOCAL_LLM_MAX_INPUT_TOKENS=6000
LOCAL_LLM_MAX_INPUT_CHARS=22000
LOCAL_LLM_SAFETY_MARGIN_TOKENS=512
LOCAL_LLM_TRUNCATION_STRATEGY=preserve_head
LOCAL_LLM_ENABLE_CHUNKED_EXTRACTION=true
LOCAL_LLM_CHUNK_LINES=80
LOCAL_LLM_CHUNK_OVERLAP_LINES=10

# Local VLM benchmark path. Use fake only for contract tests.
VLM_PROVIDER=ollama
VLM_MODEL_NAME=qwen2.5vl:7b
VLM_BASE_URL=http://127.0.0.1:11434
VLM_TEMPERATURE=0
VLM_TIMEOUT_SECONDS=600
VLM_RENDER_DPI=200
VLM_MAX_PAGES=0

# Cloud extraction is disabled until explicitly enabled.
ENABLE_CLOUD_EXTRACTION=false
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash

# Runtime helpers.
LLAMA_CPP_BINARY=
