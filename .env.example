APP_ENV=local

# Core pipeline
STOP_MARKER="NỘI DUNG VỤ ÁN"
MAX_PAGES_BEFORE_CONTENT_MARKER=7
OCR_DPI=300
SAVE_DEBUG_VISUAL=false
SAVE_DEBUG_JSON=false
ALLOW_CONTRACT_FIXTURES=false

# OCR backend selection. Fallback is disabled unless passed explicitly by CLI.
OCR_BACKEND=tesseract
FALLBACK_OCR_BACKEND=
TESSERACT_CMD=
TESSERACT_LANG=vie+eng

# Google OCR adapters are opt-in.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=

# OpenAI/Gemini OCR adapters are opt-in.
ENABLE_CLOUD_OCR=false
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-4.1-mini
GOOGLE_API_KEY=
GEMINI_OCR_MODEL=gemini-2.5-flash

# Surya is optional, never the hard-coded default.
ENABLE_SURYA_OCR=false

# Extractor backend selection.
EXTRACTOR_BACKEND=local_llm
ENABLE_LOCAL_LLM_EXTRACTION=true
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL_NAME=qwen3:4b
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_TEMPERATURE=0
LOCAL_LLM_TIMEOUT_SECONDS=180

# Local VLM page reader. Use fake only for contract tests; Ollama is the local pilot path.
VLM_PROVIDER=ollama
VLM_MODEL_NAME=qwen2.5vl:3b
VLM_BASE_URL=http://127.0.0.1:11434
VLM_TEMPERATURE=0
VLM_TIMEOUT_SECONDS=300
VLM_RENDER_DPI=200
VLM_MAX_PAGES=0

# Cloud extraction is disabled until explicitly enabled.
ENABLE_CLOUD_EXTRACTION=false
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash

# Runtime helpers.
LLAMA_CPP_BINARY=
